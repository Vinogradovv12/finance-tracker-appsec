# Copy this file to .env and change values
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=financetracker

CONNECTION_STRINGS__DEFAULTCONNECTION=Host=db;Database=financetracker;Username=your_db_user;Password=your_db_password
JWT_SECRET_KEY=your_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_HOURS=24
JWT_ISSUER=issuer_name
JWT_AUDIENCE=audience_name

ARGON2_SALT_SIZE=16
ARGON2_DEGREE_OF_PARALLELISM=4
ARGON2_ITERATIONS=3
ARGON2_MEMORY_SIZE=65536
ARGON2_HASH_SIZE=32